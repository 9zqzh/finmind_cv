# Docker 入口
APP_PORT=8080

# 生产部署镜像仓库。广州同 VPC 的阿里云 ECS 优先使用下方专有网络地址；
# 其他服务器改用 crpi-q46i31ygwyvi127o.cn-guangzhou.personal.cr.aliyuncs.com
ACR_PULL_REGISTRY=crpi-q46i31ygwyvi127o-vpc.cn-guangzhou.personal.cr.aliyuncs.com
# compose.prod.yaml 默认拉取 frontend-latest/backend-latest；发布流程会临时覆盖为发行提交 SHA。
IMAGE_TAG=latest

# PostgreSQL（密码请使用 URL 安全字符，避免空格、@、:、/）
POSTGRES_DB=finmind
POSTGRES_USER=finmind
POSTGRES_PASSWORD=

# Fernet 密钥，多个密钥按“新,旧”排列以支持轮换。必须自行生成，禁止提交真实值。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEYS=

# DeepSeek（OpenAI 兼容接口；留空时仅 AI 对话不可用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 合并到最终模型请求体的额外 JSON 参数；留空对象表示不追加。
# DeepSeek V4 开启最大思考强度示例：
# {"thinking":{"type":"enabled"},"reasoning_effort":"max"}
DEEPSEEK_EXTRA_BODY={}

# Agent 运行参数
AGENT_MAX_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=30

# 知识库检索
# auto：配置完整嵌入服务时使用 Chroma，否则使用关键词检索
# keyword：始终使用关键词检索
KNOWLEDGE_RETRIEVAL_MODE=auto
CHROMA_DIR=data/chroma
# Compose 内默认连接可选的 chroma 服务；本地运行可改为 127.0.0.1:8001。
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_HOST_PORT=8001
# 向量分数阈值：仅过滤语义明显无关项（0-1，默认 0.5）。阈值过高会误过滤相关结果，
# 最终排序由混合检索（向量 + 关键词 RRF 融合）决定，不受该阈值影响。
KNOWLEDGE_VECTOR_MIN_SCORE=0.5
# 关键词零命中时向量结果的置信门槛（0-1，默认 0.75）：低于该值视为未检索到，
# 避免完全无关的查询也返回“语义最接近”的片段
KNOWLEDGE_VECTOR_CONFIDENCE_MIN=0.75
# 混合检索时向量/关键词各自召回的候选数，融合后再截断到 top_k
KNOWLEDGE_VECTOR_TOP_K=20
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 也可以填写本地密钥文件路径；EMBEDDING_API_KEY 优先级更高。
EMBEDDING_API_KEY_FILE=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=10
# 嵌入请求失败时的重试次数（指数退避），网络抖动不影响检索稳定性
EMBEDDING_RETRIES=2

# 地图服务（高德 Web 服务 API，免费）：https://lbs.amap.com 创建应用获取 Key
AMAP_API_KEY=
# 路线规划默认起点；留空使用“广东金融学院清远校区”
AMAP_DEFAULT_ORIGIN=广东金融学院清远校区
# 默认起点经纬度兑底（“经度,纬度”）；留空表示用地理编码接口解析
AMAP_DEFAULT_LOCATION=
# 周边搜索默认半径（米）
AMAP_SEARCH_RADIUS=5000
# 可选：百度地图开放平台 Key，用于按名称补充点评数与评分（未配置则仅用高德数据）
BAIDU_MAP_API_KEY=

# 教务系统与Web服务
JWXT_BASE_URL=https://jwxt.gduf.edu.cn
APP_ENV=production
SESSION_TTL_MINUTES=120
LOGIN_SESSION_TTL_DAYS=7

# 仅非 Docker 本地开发需要设置；Compose 会使用容器内 postgres 服务覆盖此值。
DATABASE_URL=postgresql+asyncpg://finmind:请填写密码@127.0.0.1:5432/finmind

# Findpapers 学术搜索。逗号分隔启用源；默认避开未配置 Key 时容易限流的 OpenAlex。
# 可选值：arxiv、openalex、pubmed、semantic_scholar、ieee、scopus、wos。
# OpenAlex、IEEE、Scopus、Web of Science 启用前必须填写下方对应 Token。
FINDPAPERS_DATABASES=arxiv,pubmed,semantic_scholar
# 单个上游 HTTP 请求超时与整次聚合搜索总超时（秒）。
FINDPAPERS_REQUEST_TIMEOUT_SECONDS=10
FINDPAPERS_SEARCH_TIMEOUT_SECONDS=30
# 普通失败重试次数；429 默认不重试，避免上游 Retry-After 让聊天请求长时间挂起。
FINDPAPERS_MAX_RETRIES=1
FINDPAPERS_RATE_LIMIT_RETRIES=0
# 代理示例：http://127.0.0.1:7890；SSL 校验仅应在可信代理环境中关闭。
FINDPAPERS_PROXY=
FINDPAPERS_SSL_VERIFY=true
# CrossRef/PubMed 等平台使用的联系邮箱。
FINDPAPERS_EMAIL=
# Token 本身均可留空，但加入 FINDPAPERS_DATABASES 的必需密钥源必须配置对应 Token。
FINDPAPERS_IEEE_API_TOKEN=
FINDPAPERS_SCOPUS_API_TOKEN=
FINDPAPERS_PUBMED_API_TOKEN=
FINDPAPERS_OPENALEX_API_TOKEN=
FINDPAPERS_SEMANTIC_SCHOLAR_API_TOKEN=
FINDPAPERS_WOS_API_TOKEN=

# 操作手册（Playbook）与半自动进化
PLAYBOOK_DIR=data/playbooks
PLAYBOOK_DRAFT_DIR=data/playbook_drafts
# 高频判定：窗口期内提问达到该次数，或进入未覆盖问题 Top N，即视为高频
EVOLUTION_MIN_COUNT=8
EVOLUTION_WINDOW_DAYS=7
EVOLUTION_TOP_N=3
# 同一问题簇生成草稿后的冷却天数，避免重复生成
EVOLUTION_COOLDOWN_DAYS=14
# 生成草稿时从问题簇采样的对话组数
EVOLUTION_SAMPLE_SIZE=6
# 定时自进化：开关、执行间隔天数、本地时间几点触发（产出仍需人工审核的草稿）
EVOLUTION_SCHEDULE_ENABLED=true
EVOLUTION_INTERVAL_DAYS=7
EVOLUTION_RUN_HOUR=3
# 管理后台初始管理员学号；留空时全部管理接口禁用
INITIAL_ADMIN_STUDENT_NUMBER=
# 评委演示模式：true 时未登录访客自动复用管理台配置的共享教务会话（免登录体验）
# 共享会话在管理台“评委演示”页签配置，需配合 INITIAL_ADMIN_STUDENT_NUMBER 使用
DEMO_MODE=false
# 共享会话自动恢复（可选）：共享账号凭据，守护任务在会话失效时自动重登恢复
# 凭据只写服务器 .env（不入仓库）；需安装 OCR 依赖：pip install -e ".[demo]"（ddddocr）
DEMO_ACCOUNT_STUDENT_NUMBER=
DEMO_ACCOUNT_PASSWORD=
# 守护任务检查间隔（分钟）与 OCR 重试次数
DEMO_GUARD_INTERVAL_MINUTES=30
DEMO_RELOGIN_MAX_ATTEMPTS=3

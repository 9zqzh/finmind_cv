# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-你的密钥（请勿提交真实密钥）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent 运行参数
AGENT_MAX_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=30

# 知识库检索
# auto：配置完整嵌入服务时使用 Chroma，否则使用关键词检索
# keyword：始终使用关键词检索
KNOWLEDGE_RETRIEVAL_MODE=auto
CHROMA_DIR=data/chroma
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30

# 教务系统与Web服务
JWXT_BASE_URL=https://jwxt.gduf.edu.cn
APP_ENV=development
SESSION_TTL_MINUTES=120

# 学术资源平台代理（arXiv/Semantic Scholar 为境外平台，直连失败时配置本地代理）
# 例如：ACADEMIC_PROXY=http://127.0.0.1:7890；留空表示直连
ACADEMIC_PROXY=

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-你的密钥（请勿提交真实密钥）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 合并到最终模型请求体的额外 JSON 参数；留空对象表示不追加。
# DeepSeek V4 开启最大思考强度示例：
# {"thinking":{"type":"enabled"},"reasoning_effort":"max"}
DEEPSEEK_EXTRA_BODY={}

# Agent 运行参数
AGENT_MAX_ITERATIONS=4
AGENT_TIMEOUT_SECONDS=30

# 知识库检索
# auto：配置完整嵌入服务时使用 Chroma，否则使用关键词检索
# keyword：始终使用关键词检索
KNOWLEDGE_RETRIEVAL_MODE=auto
CHROMA_DIR=data/chroma
# Docker Chroma 启动后填 127.0.0.1；留空则使用嵌入式本地 Chroma。
CHROMA_HOST=
CHROMA_PORT=8001
KNOWLEDGE_VECTOR_MIN_SCORE=0.75
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 也可以填写本地密钥文件路径；EMBEDDING_API_KEY 优先级更高。
EMBEDDING_API_KEY_FILE=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=10

# 教务系统与Web服务
JWXT_BASE_URL=https://jwxt.gduf.edu.cn
APP_ENV=development
SESSION_TTL_MINUTES=120

# 学术资源平台代理（arXiv/Semantic Scholar 为境外平台，直连失败时配置本地代理）
# 例如：ACADEMIC_PROXY=http://127.0.0.1:7890；留空表示直连
ACADEMIC_PROXY=
